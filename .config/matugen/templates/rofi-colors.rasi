* {
    bg:             {{colors.background.default.hex}};
    bg-element:     rgba(0, 0, 0, 0.00);               /* Se mantiene transparente */
    bg-selected:    {{colors.primary_container.default.hex}};
    bg-dock:        {{colors.surface_variant.default.hex}};  /* Fondo del panel lateral */
    bg-btn:         {{colors.surface.default.hex}};
    bg-btn-active:  {{colors.primary.default.hex}};
    
    fg:             {{colors.on_background.default.hex}};
    fg-muted:       {{colors.on_surface_variant.default.hex}};
    fg-btn:         {{colors.on_surface.default.hex}};
    fg-btn-active:  {{colors.on_primary.default.hex}};
    
    border-win:     {{colors.primary.default.hex}};    /* Borde de la ventana */
    fg-prompt:      {{colors.tertiary.default.hex}};   /* Color del icono de búsqueda */
}
